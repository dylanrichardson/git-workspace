#!/usr/bin/env bash

set -euo pipefail

VERSION="0.3.0"
LOCK_DIR=".git/workspace-locks"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Print error and exit
error() {
    echo -e "${RED}Error: $1${NC}" >&2
    exit 1
}

# Print warning
warn() {
    echo -e "${YELLOW}Warning: $1${NC}" >&2
}

# Print info
info() {
    echo -e "${GREEN}$1${NC}" >&2
}

# Usage information
usage() {
    cat << 'EOF'
git-workspace v0.3.0

A simple tool for creating ephemeral git worktrees with automatic cleanup.

Usage: git-workspace COMMAND [OPTIONS]

Commands:
  init [bash|zsh]           Output shell integration code
                            Add to your ~/.bashrc or ~/.zshrc:
                              eval "$(git-workspace init bash)"
                            Provides: git-workspace function with auto-cd

  acquire [--name NAME]     Create a worktree and print its path
                            - Fetches latest from origin/main
                            - For use in scripts or with: cd $(git-workspace acquire)

  release [--name NAME]     Delete a worktree and print base repo path
  [--force]                 - Errors if dirty (use --force to override)
                            - Shows warning if in deleted directory
                            - For use in scripts or with: cd $(git-workspace release)

  shell [--name NAME]       Spawn shell in worktree, auto-cleanup on exit
                            - Workspace deleted automatically when shell exits

  list                      Show all managed worktrees

  clean [--force]           Remove abandoned worktrees
                            - By default: only removes clean worktrees
                            - With --force: removes dirty worktrees too

  -h, --help               Show this help

Setup (one-time):
  # Add to ~/.bashrc or ~/.zshrc for auto-cd functionality:
  eval "$(git-workspace init bash)"

Examples:
  # Acquire workspace and cd into it
  cd $(git-workspace acquire)
  # ... do work ...
  cd $(git-workspace release)

  # Named workspaces
  cd $(git-workspace acquire --name feat)
  cd $(git-workspace release --name feat)

  # Spawn a shell that auto-cleans up on exit
  git-workspace shell

  # List and clean up workspaces
  git-workspace list
  git-workspace clean
EOF
}

# Check if we're in a git repository
check_git_repo() {
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        error "Not in a git repository"
    fi
}

# Get the base repository root
get_repo_root() {
    git worktree list --porcelain | grep '^worktree' | head -n 1 | sed 's/^worktree //'
}

# Extract repository name from directory or remote
get_repo_name() {
    local repo_root="$1"
    local remote_url=$(git config --get remote.origin.url 2>/dev/null || echo "")

    if [ -n "$remote_url" ]; then
        # Extract from remote URL
        echo "$remote_url" | sed -E 's/.*\/([^\/]+)(\.git)?$/\1/' | sed 's/\.git$//'
    else
        # Fall back to directory name
        basename "$repo_root"
    fi
}

# Generate random 4-char suffix
generate_suffix() {
    cat /dev/urandom | LC_ALL=C tr -dc 'a-z0-9' | fold -w 4 | head -n 1
}

# Create lockfile for workspace
create_lock() {
    local repo_root="$1"
    local workspace_name="$2"
    local lock_pid="$3"
    local lock_dir="${repo_root}/${LOCK_DIR}"

    mkdir -p "$lock_dir"
    echo "$lock_pid" > "${lock_dir}/${workspace_name}"
}

# Remove lockfile for workspace
remove_lock() {
    local repo_root="$1"
    local workspace_name="$2"
    local lock_file="${repo_root}/${LOCK_DIR}/${workspace_name}"

    rm -f "$lock_file"
}

# Check if workspace is locked by an active process
is_locked() {
    local repo_root="$1"
    local workspace_name="$2"
    local lock_file="${repo_root}/${LOCK_DIR}/${workspace_name}"

    if [ ! -f "$lock_file" ]; then
        return 1  # Not locked
    fi

    local pid=$(cat "$lock_file" 2>/dev/null)

    # Check if process is still alive
    if kill -0 "$pid" 2>/dev/null; then
        # Check if this is a git-workspace shell process with no children
        # (means the spawned bash died but the script is stuck)
        local cmd=$(ps -o command= -p "$pid" 2>/dev/null)
        if [[ "$cmd" == *"git-workspace shell"* ]]; then
            # Check if it has any children
            if ! pgrep -P "$pid" >/dev/null 2>&1; then
                # git-workspace shell with no children = stuck/stale
                rm -f "$lock_file"
                return 1  # Not locked (cleaned up stale lock)
            fi
        fi

        return 0  # Locked by active process
    else
        # Dead process - stale lock
        rm -f "$lock_file"
        return 1  # Not locked (cleaned up stale lock)
    fi
}

# Get main branch name
get_main_branch() {
    # Try git config
    local main_branch=$(git config --get init.defaultBranch 2>/dev/null || true)
    if [ -n "$main_branch" ]; then
        echo "$main_branch"
        return
    fi

    # Try remote HEAD
    main_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || true)
    if [ -n "$main_branch" ]; then
        echo "$main_branch"
        return
    fi

    # Check if main exists
    if git show-ref --verify --quiet refs/heads/main; then
        echo "main"
        return
    fi

    # Check if master exists
    if git show-ref --verify --quiet refs/heads/master; then
        echo "master"
        return
    fi

    # Fallback to current branch
    git branch --show-current
}

# Check if workspace is dirty (has uncommitted changes or unpushed commits)
is_workspace_dirty() {
    local workspace_path="$1"
    cd "$workspace_path"

    # Check for uncommitted changes (staged and unstaged)
    if ! git diff-index --quiet HEAD -- 2>/dev/null; then
        return 0  # dirty
    fi

    # Check for untracked files
    if [ -n "$(git ls-files --others --exclude-standard)" ]; then
        return 0  # dirty
    fi

    # Check for unpushed commits
    local main_branch=$(get_main_branch)
    if [ -n "$(git log origin/${main_branch}..HEAD 2>/dev/null)" ]; then
        return 0  # dirty
    fi

    return 1  # clean
}

# Check if a workspace name is managed by us (follows our naming convention)
is_managed_workspace() {
    local workspace_path="$1"
    local repo_root="$2"

    # Must not be the base repo
    if [ "$workspace_path" = "$repo_root" ]; then
        return 1
    fi

    # Must exist
    if [ ! -d "$workspace_path" ]; then
        return 1
    fi

    # Check if branch name follows our convention
    cd "$workspace_path"
    local current_branch=$(git branch --show-current)
    if [[ "$current_branch" == workspace/* ]]; then
        return 0
    fi

    return 1
}

# Command: acquire workspace
cmd_acquire() {
    local custom_name=""
    local shell_pid="$$"

    # Parse options
    while [ $# -gt 0 ]; do
        case "$1" in
            --name)
                if [ $# -lt 2 ]; then
                    error "--name requires an argument"
                fi
                custom_name="$2"
                shift 2
                ;;
            --shell-pid)
                if [ $# -lt 2 ]; then
                    error "--shell-pid requires an argument"
                fi
                shell_pid="$2"
                shift 2
                ;;
            *)
                error "Unknown option: $1"
                ;;
        esac
    done

    check_git_repo
    local repo_root=$(get_repo_root)
    local parent_dir=$(dirname "$repo_root")
    local base_name=$(get_repo_name "$repo_root")
    local main_branch=$(get_main_branch)

    # Determine workspace name and path
    local workspace_name=""
    local workspace_path=""

    if [ -n "$custom_name" ]; then
        workspace_name="$custom_name"
        workspace_path="${parent_dir}/${custom_name}"

        # Check if already exists
        if [ -e "$workspace_path" ]; then
            error "Workspace '$custom_name' already exists at: $workspace_path"
        fi
    else
        # Generate unique random name
        local attempts=0
        while [ $attempts -lt 100 ]; do
            local suffix=$(generate_suffix)
            workspace_name="${base_name}-${suffix}"
            workspace_path="${parent_dir}/${workspace_name}"

            if [ ! -e "$workspace_path" ]; then
                break
            fi

            attempts=$((attempts + 1))
        done

        if [ $attempts -ge 100 ]; then
            error "Failed to generate unique workspace name after 100 attempts"
        fi
    fi

    # Create branch and worktree
    local branch_name="workspace/${workspace_name}"

    cd "$repo_root"

    # Fetch latest
    git fetch origin "$main_branch" >/dev/null 2>&1

    # Create branch tracking origin/main
    git branch "$branch_name" "origin/$main_branch" >/dev/null 2>&1 || \
        git branch "$branch_name" "$main_branch" >/dev/null 2>&1

    # Create worktree
    git worktree add "$workspace_path" "$branch_name" >/dev/null 2>&1

    # Create lock
    create_lock "$repo_root" "$workspace_name" "$shell_pid"

    # Print path to stdout (for cd)
    echo "$workspace_path"
}

# Command: release workspace
cmd_release() {
    local custom_name=""
    local force=false
    local quiet=false

    # Parse options
    while [ $# -gt 0 ]; do
        case "$1" in
            --name)
                custom_name="$2"
                shift 2
                ;;
            --force)
                force=true
                shift
                ;;
            --quiet)
                quiet=true
                shift
                ;;
            *)
                error "Unknown option: $1"
                ;;
        esac
    done

    check_git_repo
    local repo_root=$(get_repo_root)
    local parent_dir=$(dirname "$repo_root")

    # Determine workspace path
    local workspace_path=""

    if [ -n "$custom_name" ]; then
        workspace_path="${parent_dir}/${custom_name}"
    else
        workspace_path=$(pwd)
    fi

    # Validate it's a worktree
    if [ ! -d "$workspace_path" ]; then
        error "Workspace does not exist: $workspace_path"
    fi

    if [ ! -f "${workspace_path}/.git" ]; then
        error "Not a worktree: $workspace_path"
    fi

    # Get branch name
    cd "$workspace_path"
    local branch_name=$(git branch --show-current)

    # Check if managed by us
    if [[ "$branch_name" != workspace/* ]]; then
        error "Not a managed workspace (branch: $branch_name)"
    fi

    # Check if dirty
    if is_workspace_dirty "$workspace_path"; then
        if [ "$force" = false ]; then
            error "Workspace is dirty (uncommitted changes or unpushed commits). Use --force to delete anyway."
        else
            warn "Deleting dirty workspace!"
        fi
    fi

    # Warn if in workspace being deleted (unless --quiet)
    if [ "$quiet" = false ]; then
        local current_dir=$(pwd)
        if [ "$current_dir" = "$workspace_path" ] || [[ "$current_dir" == "$workspace_path"/* ]]; then
            warn "You are in the workspace being deleted!"
            warn "You'll be in a deleted directory after this."
            warn "The path printed below is the base repo - cd to it."
        fi
    fi

    # Delete worktree and branch
    cd "$repo_root"
    git worktree remove "$workspace_path" --force 2>/dev/null || rm -rf "$workspace_path"
    git branch -D "$branch_name" >/dev/null 2>&1 || true

    # Remove lock
    local workspace_name=$(basename "$workspace_path")
    remove_lock "$repo_root" "$workspace_name"

    # Print base repo path
    echo "$repo_root"
}

# Command: shell workspace
cmd_shell() {
    local custom_name=""

    # Parse options
    while [ $# -gt 0 ]; do
        case "$1" in
            --name)
                custom_name="$2"
                shift 2
                ;;
            *)
                error "Unknown option: $1"
                ;;
        esac
    done

    check_git_repo
    local repo_root=$(get_repo_root)

    # Acquire workspace
    local workspace_path
    if [ -n "$custom_name" ]; then
        workspace_path=$(cmd_acquire --name "$custom_name")
    else
        workspace_path=$(cmd_acquire)
    fi

    # Validate we got a workspace
    if [ -z "$workspace_path" ] || [ ! -d "$workspace_path" ]; then
        error "Failed to acquire workspace"
    fi

    # Get branch name for cleanup
    cd "$workspace_path"
    local branch_name=$(git branch --show-current)

    # Capture variables for cleanup (must be non-local for trap access)
    CLEANUP_WORKSPACE_PATH="$workspace_path"
    CLEANUP_BRANCH_NAME="$branch_name"

    # Setup cleanup trap
    cleanup() {
        local cleanup_repo_root=$(get_repo_root)
        cd "$cleanup_repo_root"
        git worktree remove "$CLEANUP_WORKSPACE_PATH" --force 2>/dev/null || rm -rf "$CLEANUP_WORKSPACE_PATH"
        git branch -D "$CLEANUP_BRANCH_NAME" >/dev/null 2>&1 || true

        # Remove lock
        local workspace_name=$(basename "$CLEANUP_WORKSPACE_PATH")
        remove_lock "$cleanup_repo_root" "$workspace_name"
    }
    trap cleanup EXIT INT TERM HUP

    # Spawn shell (NOT exec, so trap fires)
    cd "$workspace_path"

    # Export workspace name for prompt customization
    export GIT_WORKSPACE_NAME="$(basename "$workspace_path")"

    ${SHELL:-/bin/bash}

    # When shell exits, trap will fire and cleanup runs
}

# Command: init (output shell integration)
cmd_init() {
    local shell_type="${1:-bash}"

    cat << 'EOF'
# git-workspace shell integration
# This was generated by: git-workspace init

git-workspace() {
    case "$1" in
        enter)
            shift
            local workspace_path
            workspace_path=$(command git-workspace acquire --shell-pid $$ "$@") || return 1
            cd "$workspace_path" || return 1
            export GIT_WORKSPACE_NAME=$(basename "$workspace_path")
            ;;
        exit)
            shift
            cd "$(command git-workspace release --quiet "$@")" || return 1
            unset GIT_WORKSPACE_NAME
            ;;
        --help|-h)
            cat << 'HELP_EOF'
git-workspace v0.3.0

Usage: git-workspace COMMAND [OPTIONS]

Commands (with shell integration):
  enter [--name NAME]       Enter workspace (auto-cd into it)
  exit [--name NAME]        Exit workspace (auto-cd back to base repo)
  [--force]

  list                      Show all managed worktrees
  clean [--force]           Remove abandoned worktrees
  shell [--name NAME]       Spawn shell in worktree, auto-cleanup on exit

  acquire [--name NAME]     Create worktree and print path (for scripts)
  release [--name NAME]     Delete worktree and print base path (for scripts)
  [--force]

Examples:
  # Main workflow
  git-workspace enter           # Enter workspace
  # ... do work ...
  git-workspace exit            # Exit workspace

  # Named workspaces
  git-workspace enter --name feat
  git-workspace exit --name feat

  # List and cleanup
  git-workspace list
  git-workspace clean

Run 'command git-workspace --help' for full documentation.
HELP_EOF
            ;;
        *)
            command git-workspace "$@"
            ;;
    esac
}
EOF
}

# Command: list workspaces
cmd_list() {
    check_git_repo
    local repo_root=$(get_repo_root)

    echo "Managed workspaces:"
    echo ""

    local found=0

    # Parse git worktree list
    while IFS= read -r line; do
        if [[ "$line" == worktree* ]]; then
            local workspace_path=$(echo "$line" | sed 's/^worktree //')

            # Check if managed by us
            if is_managed_workspace "$workspace_path" "$repo_root"; then
                found=1

                cd "$workspace_path"
                local branch_name=$(git branch --show-current)
                local workspace_name=$(basename "$workspace_path")

                # Check lock status
                local lock_status=""
                if is_locked "$repo_root" "$workspace_name"; then
                    lock_status="${RED}[LOCKED]${NC}"
                else
                    lock_status="${GREEN}[AVAILABLE]${NC}"
                fi

                # Check if dirty
                local dirty_status=""
                if is_workspace_dirty "$workspace_path"; then
                    dirty_status="${YELLOW}[DIRTY]${NC}"
                else
                    dirty_status="${GREEN}[CLEAN]${NC}"
                fi

                echo -e "  $lock_status $dirty_status $workspace_path (branch: $branch_name)"
            fi
        fi
    done < <(git worktree list --porcelain)

    if [ $found -eq 0 ]; then
        echo "  No managed workspaces found"
    fi
}

# Command: clean abandoned workspaces
cmd_clean() {
    local force=false

    # Parse options
    while [ $# -gt 0 ]; do
        case "$1" in
            --force)
                force=true
                shift
                ;;
            *)
                error "Unknown option: $1"
                ;;
        esac
    done

    check_git_repo
    local repo_root=$(get_repo_root)

    info "Cleaning up workspaces..."

    local cleaned=0
    local skipped_locked=0
    local skipped_dirty=0

    # Parse git worktree list
    while IFS= read -r line; do
        if [[ "$line" == worktree* ]]; then
            local workspace_path=$(echo "$line" | sed 's/^worktree //')

            # Check if managed by us
            if is_managed_workspace "$workspace_path" "$repo_root"; then
                cd "$workspace_path"
                local branch_name=$(git branch --show-current)
                local workspace_name=$(basename "$workspace_path")

                # Check if locked by active process
                if is_locked "$repo_root" "$workspace_name"; then
                    if [ "$force" = true ]; then
                        warn "Removing locked worktree: $workspace_path (--force)"
                        cd "$repo_root"
                        git worktree remove "$workspace_path" --force 2>/dev/null || rm -rf "$workspace_path"
                        git branch -D "$branch_name" >/dev/null 2>&1 || true
                        remove_lock "$repo_root" "$workspace_name"
                        cleaned=$((cleaned + 1))
                    else
                        warn "Skipping locked worktree: $workspace_path (use --force)"
                        skipped_locked=$((skipped_locked + 1))
                    fi
                    continue
                fi

                # Check if dirty
                if is_workspace_dirty "$workspace_path"; then
                    if [ "$force" = true ]; then
                        warn "Removing dirty worktree: $workspace_path (--force)"
                        cd "$repo_root"
                        git worktree remove "$workspace_path" --force 2>/dev/null || rm -rf "$workspace_path"
                        git branch -D "$branch_name" >/dev/null 2>&1 || true
                        remove_lock "$repo_root" "$workspace_name"
                        cleaned=$((cleaned + 1))
                    else
                        warn "Skipping dirty worktree: $workspace_path (use --force)"
                        skipped_dirty=$((skipped_dirty + 1))
                    fi
                else
                    # Check if user is in this workspace
                    local current_dir=$(pwd)
                    if [ "$current_dir" = "$workspace_path" ] || [[ "$current_dir" == "$workspace_path"/* ]]; then
                        warn "You are in $workspace_path which will be deleted!"
                        warn "You'll be in a deleted directory after this."
                    fi

                    info "Removing clean worktree: $workspace_path"
                    cd "$repo_root"
                    git worktree remove "$workspace_path" 2>/dev/null || rm -rf "$workspace_path"
                    git branch -D "$branch_name" >/dev/null 2>&1 || true
                    remove_lock "$repo_root" "$workspace_name"
                    cleaned=$((cleaned + 1))
                fi
            fi
        fi
    done < <(git worktree list --porcelain)

    info "Cleaned up $cleaned workspace(s)"
    if [ $skipped_locked -gt 0 ]; then
        warn "Skipped $skipped_locked locked workspace(s)"
    fi
    if [ $skipped_dirty -gt 0 ]; then
        warn "Skipped $skipped_dirty dirty workspace(s)"
    fi
}

# Main
main() {
    if [ $# -eq 0 ]; then
        usage
        exit 0
    fi

    local command="$1"
    shift

    case "$command" in
        init)
            cmd_init "$@"
            ;;
        acquire)
            cmd_acquire "$@"
            ;;
        release)
            cmd_release "$@"
            ;;
        shell)
            cmd_shell "$@"
            ;;
        list)
            cmd_list "$@"
            ;;
        clean)
            cmd_clean "$@"
            ;;
        enter|exit)
            error "'$command' requires shell integration. Use 'git-workspace' (with hyphen) or run: eval \"\$(git-workspace init bash)\""
            ;;
        --version|-v)
            echo "git-workspace v${VERSION}"
            exit 0
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            error "Unknown command: $command. Use --help for usage."
            ;;
    esac
}

main "$@"
